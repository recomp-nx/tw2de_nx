# Auto-generated by rexglue codegen - DO NOT EDIT
# DLL modules, linked into the executable
#
# tw2de (2026-11-09): the Switch has no shared libraries: each module's generated code is compiled as an object
# library, linked partially into one object (gcc -r; the precompiled header CMake lists among the objects left out), its own symbols made local and its entry points renamed
# ReXModule_Register_<module> / ReXModule_GetImageInfo_<module> (cmake/rexglue_static_module.cmake), and that object
# linked into the executable. The generated module registry hands the entry points to the kernel, which wires a module
# when the game loads it (KernelState::LoadUserModule).

{% for mod in dll_modules %}
# DLL module: {{ mod.target_name }}
if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}/sources.cmake")
    set(_REXGLUE_RESTORE_GENERATED_SOURCES FALSE)
    if(DEFINED GENERATED_SOURCES)
        set(_REXGLUE_PREVIOUS_GENERATED_SOURCES {{ cmake_var("GENERATED_SOURCES") }})
        set(_REXGLUE_RESTORE_GENERATED_SOURCES TRUE)
    endif()
    include({{ mod.output_dir }}/sources.cmake)
    set(DLL_SOURCES_{{ mod.target_name }} {{ cmake_var("GENERATED_SOURCES") }})
    if(_REXGLUE_RESTORE_GENERATED_SOURCES)
        set(GENERATED_SOURCES {{ cmake_var("_REXGLUE_PREVIOUS_GENERATED_SOURCES") }})
    else()
        unset(GENERATED_SOURCES)
    endif()
    unset(_REXGLUE_PREVIOUS_GENERATED_SOURCES)
    unset(_REXGLUE_RESTORE_GENERATED_SOURCES)
    add_library({{ mod.lib_name }} OBJECT {{ cmake_var("DLL_SOURCES_" + mod.target_name) }})
    target_include_directories({{ mod.lib_name }} PRIVATE
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}
    )
    target_link_libraries({{ mod.lib_name }} PRIVATE rex::runtime)
    rexglue_apply_recomp_settings({{ mod.lib_name }}
        "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}/{{ project }}_pch.h")
    if(TARGET {{ project }}_codegen)
        add_dependencies({{ mod.lib_name }} {{ project }}_codegen)
    endif()
    # The partial link needs plain objects: no link-time optimisation in a module.
    set_target_properties({{ mod.lib_name }} PROPERTIES INTERPROCEDURAL_OPTIMIZATION OFF)
    target_compile_options({{ mod.lib_name }} PRIVATE -fno-lto)
    rexglue_apply_target_settings({{ mod.lib_name }})
    set(_rexglue_module_o "{{ cmake_var("CMAKE_CURRENT_BINARY_DIR") }}/{{ mod.lib_name }}_module.o")
    add_custom_command(
        OUTPUT "{{ cmake_var("_rexglue_module_o") }}"
        COMMAND {{ cmake_var("CMAKE_CXX_COMPILER") }} -r -nostdlib -fno-lto -o "{{ cmake_var("_rexglue_module_o") }}.partial.o"
                "$<FILTER:$<TARGET_OBJECTS:{{ mod.lib_name }}>,EXCLUDE,\\.gch$>"
        COMMAND {{ cmake_var("CMAKE_COMMAND") }} -DNM={{ cmake_var("CMAKE_NM") }} -DOBJCOPY={{ cmake_var("CMAKE_OBJCOPY") }}
                "-DIN_OBJ={{ cmake_var("_rexglue_module_o") }}.partial.o" "-DOUT_OBJ={{ cmake_var("_rexglue_module_o") }}"
                -DSYMBOL={{ mod.symbol }} -P "{{ cmake_var("REXGLUE_STATIC_MODULE_SCRIPT") }}"
        DEPENDS $<TARGET_OBJECTS:{{ mod.lib_name }}> "{{ cmake_var("REXGLUE_STATIC_MODULE_SCRIPT") }}"
        COMMAND_EXPAND_LISTS
        VERBATIM
        COMMENT "Linking DLL module {{ mod.target_name }} into one object")
    add_custom_target({{ mod.lib_name }}_module DEPENDS "{{ cmake_var("_rexglue_module_o") }}")
    set_source_files_properties("{{ cmake_var("_rexglue_module_o") }}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
    cmake_language(EVAL CODE
        "cmake_language(DEFER CALL target_sources {{ cmake_var("REXGLUE_HOST_TARGET") }} PRIVATE \"{{ cmake_var("_rexglue_module_o") }}\")")
    cmake_language(EVAL CODE
        "cmake_language(DEFER CALL add_dependencies {{ cmake_var("REXGLUE_HOST_TARGET") }} {{ mod.lib_name }}_module)")
endif()
{% endfor %}
