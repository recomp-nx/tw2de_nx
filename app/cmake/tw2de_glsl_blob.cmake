# tw2de (2026-10-23): one of Renut's own shaders for the Switch, as the GLSL the console compiles (cmake -P).
#
#   cmake -DSRC=<stem>.glsl -DSTEM=<stem> -DSTAGE=<DkStage> -DOUT=<stem>.deko3d.h -P tw2de_glsl_blob.cmake
#
# The header holds g_<stem>_deko3d, a plume::Deko3DShaderBlob (plume_deko3d.h): 16 bytes, little-endian ("BDK3", the
# DkStage with StagePlainUam, the GLSL's size, 0: no DKSH), then the GLSL. With no DKSH plume compiles the text on the
# console with uam, the way it compiles the game's shaders (its DKSH cache on the SD card, then the compile thread).
cmake_minimum_required(VERSION 3.20)
foreach(var SRC STEM STAGE OUT)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "tw2de_glsl_blob.cmake: ${var} is not set")
  endif()
endforeach()

file(READ "${SRC}" glsl_hex HEX)
string(LENGTH "${glsl_hex}" hex_len)
math(EXPR glsl_size "${hex_len} / 2")
if(glsl_size EQUAL 0)
  message(FATAL_ERROR "tw2de_glsl_blob.cmake: ${SRC} is empty")
endif()

# A 32-bit value as four little-endian bytes in hex.
function(le32 value out)
  math(EXPR b0 "${value} & 255" OUTPUT_FORMAT HEXADECIMAL)
  math(EXPR b1 "(${value} >> 8) & 255" OUTPUT_FORMAT HEXADECIMAL)
  math(EXPR b2 "(${value} >> 16) & 255" OUTPUT_FORMAT HEXADECIMAL)
  math(EXPR b3 "(${value} >> 24) & 255" OUTPUT_FORMAT HEXADECIMAL)
  set(bytes "")
  foreach(b ${b0} ${b1} ${b2} ${b3})
    string(SUBSTRING "${b}" 2 -1 digits)
    string(LENGTH "${digits}" n)
    if(n EQUAL 1)
      set(digits "0${digits}")
    endif()
    string(APPEND bytes "${digits}")
  endforeach()
  set(${out} "${bytes}" PARENT_SCOPE)
endfunction()

le32(860570690 magic)   # 0x334B4442, "BDK3"
# tw2de (2026-10-24): the stage with plume's Deko3DShaderBlob::StagePlainUam (bit 31): a host shader, compiled with
# uam's tw2de flags at 0 as its DKSH was made on the PC until v150 (the game shaders' optimisations are not for these).
math(EXPR stage_word "${STAGE} + 2147483648")
if(META_ONLY)
  # tw2de (2026-11-06): -DMETA_ONLY=ON (its DKSH is in the NRO's romfs, made at build time with devkitPro's uam:
  # src/renut_engine/gpu/gpu.cmake): no text, only what plume reads from it when it makes the shader (Deko3DShaderMeta:
  # the tw2de-dk line's bindings, the declared varying locations, the vszero mask; no specialization constants, so
  # no variant but the default, which the DKSH is) and the first 8 bytes of the text's SHA-256 (the default variant's
  # key). Deko3DShaderBlob::StageMetaOnly (bit 30); glslSize is then the record's size. The record,
  # little-endian u32s (plume_deko3d.cpp Deko3DDevice::createShader reads it):
  #   2 (version), key low, key high, ubo, ssbo, tex (0/1), txq, input mask, output mask, vszero mask,
  #   texb count, texb items (texture word | sampler word << 16), vin count, vin items.
  # Then, as for every blob with StageNamed (bit 29), the shader's name and a 0 byte: its DKSH is shaders/<name>.dksh.
  file(READ "${SRC}" text)
  if(text MATCHES "SPIRV_CROSS_CONSTANT_ID")
    message(FATAL_ERROR "tw2de_glsl_blob.cmake: ${SRC} has specialization constants: it needs its text (no META_ONLY)")
  endif()
  file(SHA256 "${SRC}" sha)
  string(SUBSTRING "${sha}" 0 8 key_hi)
  string(SUBSTRING "${sha}" 8 8 key_lo)
  math(EXPR key_hi "0x${key_hi}")
  math(EXPR key_lo "0x${key_lo}")
  # parseUsage's fields of the "// tw2de-dk " line (the key anywhere in the line, its value up to a space).
  set(ubo 0)
  set(ssbo 0)
  set(tex 0)
  set(txq 0)
  set(texb "")
  set(vin "")
  string(FIND "${text}" "// tw2de-dk " at)
  if(NOT at EQUAL -1)
    string(SUBSTRING "${text}" ${at} -1 rest)
    string(FIND "${rest}" "\n" nl)
    string(SUBSTRING "${rest}" 0 ${nl} line)
    foreach(key ubo ssbo tex txq texb vin)
      string(FIND "${line}" "${key}=" k)
      if(NOT k EQUAL -1)
        string(LENGTH "${key}=" kl)
        math(EXPR v "${k} + ${kl}")
        string(SUBSTRING "${line}" ${v} -1 value)
        string(FIND "${value}" " " sp)
        if(NOT sp EQUAL -1)
          string(SUBSTRING "${value}" 0 ${sp} value)
        endif()
        set(${key} "${value}")
      endif()
    endforeach()
  endif()
  foreach(key ubo ssbo txq)  # strtoul base 16 ("0x20" or "20")
    if(${key} STREQUAL "")
      set(${key} 0)
    else()
      string(REGEX REPLACE "^0[xX]" "" digits "${${key}}")
      math(EXPR ${key} "0x${digits}")
    endif()
  endforeach()
  math(EXPR ssbo_bit "${ssbo} & 16384")
  if(ssbo_bit)
    math(EXPR ssbo "${ssbo} | 4096")  # exports (binding 14) bind the page flags (12) too, as parseUsage does
  endif()
  if(tex STREQUAL "1")
    set(tex 1)
  else()
    set(tex 0)
  endif()
  set(texb_words "")
  set(texb_count 0)
  if(NOT texb STREQUAL "")
    string(REPLACE "," ";" items "${texb}")
    foreach(item ${items})
      if(item MATCHES "^([0-9]+):([0-9]+):([0-9]+)$" AND CMAKE_MATCH_1 EQUAL texb_count)
        math(EXPR w "(${CMAKE_MATCH_2} & 65535) | ((${CMAKE_MATCH_3} & 65535) << 16)")
        le32(${w} wb)
        string(APPEND texb_words "${wb}")
        math(EXPR texb_count "${texb_count} + 1")
      endif()
    endforeach()
  endif()
  set(vin_words "")
  set(vin_count 0)
  if(NOT vin STREQUAL "")
    string(REPLACE "," ";" items "${vin}")
    foreach(item ${items})
      if(item MATCHES "^([0-9]+)")
        le32(${CMAKE_MATCH_1} wb)
      else()
        le32(0 wb)
      endif()
      string(APPEND vin_words "${wb}")
      math(EXPR vin_count "${vin_count} + 1")
    endforeach()
  endif()
  # The varying locations it declares ("\nlayout(location = N) in " / ") out ", below 32).
  set(in_mask 0)
  set(out_mask 0)
  string(REGEX MATCHALL "\nlayout\\(location = [0-9]+\\) (in|out) " decls "${text}")
  foreach(d ${decls})
    string(REGEX MATCH "= ([0-9]+)\\) (in|out)" m "${d}")
    set(loc "${CMAKE_MATCH_1}")
    if(loc LESS 32)
      if(CMAKE_MATCH_2 STREQUAL "in")
        math(EXPR in_mask "${in_mask} | (1 << ${loc})")
      else()
        math(EXPR out_mask "${out_mask} | (1 << ${loc})")
      endif()
    endif()
  endforeach()
  set(vszero 0)
  if(text MATCHES "\n// tw2de-vszero=0x([0-9a-fA-F]+)")
    math(EXPR vszero "0x${CMAKE_MATCH_1}")
  endif()
  set(record "")
  foreach(value 2 ${key_lo} ${key_hi} ${ubo} ${ssbo} ${tex} ${txq} ${in_mask} ${out_mask} ${vszero})
    le32(${value} wb)
    string(APPEND record "${wb}")
  endforeach()
  le32(${texb_count} wb)
  string(APPEND record "${wb}${texb_words}")
  le32(${vin_count} wb)
  string(APPEND record "${wb}${vin_words}")
  string(LENGTH "${record}" record_len)
  math(EXPR record_size "${record_len} / 2")
  math(EXPR stage_word "${stage_word} + 1073741824")  # StageMetaOnly
  set(payload "${record}")
  set(glsl_size ${record_size})
else()
  set(payload "${glsl_hex}")
endif()
# tw2de (2026-11-06): StageNamed (bit 29): after the text (or the record) the shader's name (the GLSL's stem) and a 0
# byte, for its DKSH in the NRO's romfs (shaders/<name>.dksh). -DNAMED=OFF (gpu.cmake's
# console_uam_shaders): no name, so the console compiles the text at its first use (no DKSH looked up).
if(DEFINED NAMED AND NOT NAMED)
  if(META_ONLY)
    message(FATAL_ERROR "tw2de_glsl_blob.cmake: ${SRC}: NAMED=OFF needs the text (no META_ONLY)")
  endif()
  set(name_part "")
else()
  math(EXPR stage_word "${stage_word} + 536870912")
  string(HEX "${STEM}" name_hex)
  set(name_part "${name_hex}00")
endif()
le32(${stage_word} stage)
le32(${glsl_size} size)
le32(0 dksh)
set(blob "${magic}${stage}${size}${dksh}${payload}${name_part}")

# 24 bytes a line, as the former PC tool wrote them (CMake's regex has no {n}: a loop over 48 hex digits).
string(TOUPPER "${blob}" blob)
string(LENGTH "${blob}" blob_len)
set(bytes "")
set(pos 0)
while(pos LESS blob_len)
  string(SUBSTRING "${blob}" ${pos} 48 chunk)
  string(REGEX REPLACE "([0-9A-F][0-9A-F])" "0x\\1, " chunk "${chunk}")
  string(REGEX REPLACE " $" "" chunk "${chunk}")
  if(pos GREATER 0)
    string(APPEND bytes "\n    ")
  endif()
  string(APPEND bytes "${chunk}")
  math(EXPR pos "${pos} + 48")
endwhile()

get_filename_component(src_name "${SRC}" NAME)
if(META_ONLY)
  set(what "its metadata (${glsl_size} bytes), no text: its DKSH is in the NRO's romfs")
else()
  set(what "${glsl_size} bytes of GLSL (its default variant's DKSH in the NRO's romfs when built with uam, else compiled on the console)")
endif()
set(text "// Generated by app/cmake/tw2de_glsl_blob.cmake from ${src_name}: ${what}.
#pragma once
#include <cstdint>
static const uint8_t g_${STEM}_deko3d[] = {
    ${bytes}
};
")
# Written only when it changes, so the files that include it are not compiled again for nothing.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
get_filename_component(out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
file(WRITE "${OUT}.tmp" "${text}")
file(RENAME "${OUT}.tmp" "${OUT}")
